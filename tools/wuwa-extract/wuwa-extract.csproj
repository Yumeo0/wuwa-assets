<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wuwa-extract</AssemblyName>
    <RootNamespace>WuwaExtract</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202611" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Override the converter's exact 2.88.9 pin for PNG extraction. -->
    <PackageReference Include="SkiaSharp" Version="4.156.0" NoWarn="NU1608" />
  </ItemGroup>

  <!-- Keep transitive dependencies current while upstream still requests older releases. -->
  <ItemGroup>
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="FixedMathSharp" Version="8.0.0" />
    <PackageReference Include="IndexRange" Version="1.1.1" />
    <PackageReference Include="MemoryPack" Version="1.22.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="11.0.0" />
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="7.0.4" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NETStandard.Library" Version="2.0.3" />
    <PackageReference Include="OffiUtils" Version="4.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.7" />
    <!-- Only the converter's unused TGA encoder needs ImageSharp; do not ship it. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" ExcludeAssets="all" NoWarn="NU1608" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>

</Project>
